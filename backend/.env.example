# ---- Vertex AI ----
# Path to the service-account JSON key (mounted, not committed).
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Live model id. On Vertex AI this is typically one of:
#   gemini-live-2.5-flash-preview-native-audio
#   gemini-2.0-flash-live-preview-04-09
LIVE_MODEL=gemini-live-2.5-flash-preview-native-audio

# Prebuilt voice (professional female tone). e.g. Aoede, Kore, Leda.
VOICE_NAME=Aoede

# ---- Server ----
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed browser origins for CORS/WebSocket.
ALLOWED_ORIGINS=http://localhost:5173
