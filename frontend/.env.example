# WebSocket URL of the FastAPI backend. In dev, Vite proxies /ws to :8000,
# so the default relative path works. Override for a deployed backend.
VITE_WS_URL=/ws

# Path (under public/) to a GLB avatar rigged with ARKit / Oculus visemes.
# If the file is absent, a procedural placeholder head is rendered instead.
VITE_AVATAR_URL=/models/avatar.glb
